# Required secrets. Remote CTRL refuses to start while one is still CHANGE_ME.
# Generate each with: openssl rand -hex 32
# Keep APP_SECRET unchanged for the life of the data volume: saved host
# passwords and keys are encrypted with it.
APP_SECRET=CHANGE_ME
RDP_GUACAMOLE_PASSWORD=CHANGE_ME
GUACAMOLE_POSTGRES_PASSWORD=CHANGE_ME

# Internal Guacamole administrator Remote CTRL signs in as. Not "guacadmin".
RDP_GUACAMOLE_USERNAME=remotectrl

# Behind an HTTPS reverse proxy (see README):
# TRUST_PROXY_HOPS=1
# AUTH_COOKIE_SECURE=true
# RDP_GUACAMOLE_PUBLIC_URL=/remote/guacamole
