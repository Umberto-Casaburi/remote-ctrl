# Required. Generate each value with: openssl rand -base64 36
# Keep APP_SECRET unchanged for the life of the data volume: saved host
# passwords and keys are encrypted with it.
APP_SECRET=CHANGE_ME
RDP_GUACAMOLE_USERNAME=CHANGE_ME
RDP_GUACAMOLE_PASSWORD=CHANGE_ME
GUACAMOLE_POSTGRES_PASSWORD=CHANGE_ME

# Address users open for embedded RDP/VNC sessions.
RDP_GUACAMOLE_PUBLIC_URL=http://localhost:8080/guacamole

# Behind an HTTPS reverse proxy:
# TRUST_PROXY_HOPS=1
# AUTH_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://remote.example.com
